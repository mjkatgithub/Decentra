# Copy this file to tests/e2e/.env.e2e.local for local E2E runs.
BASE_URL=http://localhost:3000
E2E_MATRIX_HOMESERVER=https://matrix.org
E2E_MATRIX_USERNAME=@example:matrix.org
E2E_MATRIX_PASSWORD=change-me

# Local Synapse (npm run test:e2e) — generated by runtime-seed-synapse
# E2E_USE_LOCAL_SYNAPSE=1
# E2E_LOCAL_HOMESERVER=http://127.0.0.1:8008
# Set by scripts when using docker Synapse+MailHog; see tests/e2e/EMAIL-SIGNUP.md
# DECENTRA_E2E_SIGNUP_EMAIL=1
# MAILHOG_API_BASE=http://127.0.0.1:8025
# Set by scripts when using docker Synapse with registration captcha;
# see tests/e2e/RECAPTCHA-SIGNUP.md
# DECENTRA_E2E_SIGNUP_RECAPTCHA=1
